<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="plmunAMS_user.Views.SignUpPage"
             Title="Back"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Accent">#96d1ff</Color>
        </ResourceDictionary>
    </ContentPage.Resources>


    <ScrollView>

        <StackLayout Padding="10,0,10,0" VerticalOptions="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Username -->
                <StackLayout  Grid.Row="0">
                    <Frame
                       Padding="0"
                       Margin="10,0,10,0"
                       CornerRadius="15"
                       BackgroundColor="#F3F3F3">

                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="Username"
                           PlaceholderColor="#848484"
                           x:Name="user">
                        </Entry>
                    </Frame>
                </StackLayout>

                <!-- Password -->
                <StackLayout  Grid.Row="1">
                    <Frame
                       Padding="0" 
                       CornerRadius="15"
                       Margin="10,20,10,0"
                       BackgroundColor="#F3F3F3">
                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="Password"
                           PlaceholderColor="#848484"
                           IsPassword="True"
                           x:Name="pass">
                        </Entry>
                    </Frame>
                </StackLayout>

                <!-- Repeat Pass -->
                <StackLayout  Grid.Row="2">
                    <Frame
                       Padding="0" 
                       CornerRadius="15"
                       Margin="10,20,10,0"
                       BackgroundColor="#F3F3F3">
                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="Repeat Password"
                           PlaceholderColor="#848484"
                           IsPassword="True"
                           x:Name="passRepeat">
                        </Entry>
                    </Frame>
                </StackLayout>

                <!-- First Name -->
                <StackLayout  Grid.Row="3">
                    <Frame
                       Padding="0" 
                       CornerRadius="15"
                       BackgroundColor="#F3F3F3"
                       Margin="10,20,10,0">
                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="First Name"
                           PlaceholderColor="#848484"
                           x:Name="firstname">
                        </Entry>
                    </Frame>
                </StackLayout>

                <!-- Middle Name -->
                <StackLayout  Grid.Row="4">
                    <Frame
                       Padding="0" 
                       CornerRadius="15"
                       BackgroundColor="#F3F3F3"
                       Margin="10,20,10,0">
                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="Middle Name"
                           PlaceholderColor="#848484"
                           x:Name="middlename">
                        </Entry>
                    </Frame>
                </StackLayout>

                <!-- Last Name -->
                <StackLayout  Grid.Row="5">
                    <Frame
                       Padding="0" 
                       CornerRadius="15"
                       BackgroundColor="#F3F3F3"
                       Margin="10,20,10,0">
                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="Last Name"
                           PlaceholderColor="#848484"
                           x:Name="lastname">
                        </Entry>
                    </Frame>
                </StackLayout>

                <!-- Student No. & Section -->
                <StackLayout Grid.Row="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Student No. -->
                        <Frame Grid.Column="0"
                               Padding="0" 
                               CornerRadius="15"
                               BackgroundColor="#F3F3F3"
                               Margin="10,10,0,0">

                            <Entry Margin="20,0,0,0"
                                   BackgroundColor="#F3F3F3"
                                   TextColor="Black"
                                   FontFamily="Nunito-Bold"
                                   Placeholder="Student Number"
                                   PlaceholderColor="#848484"
                                   x:Name="studNo"/>  
                        </Frame>

                        <!-- Section -->
                        <Frame Grid.Column="1"
                               Padding="0" 
                               CornerRadius="15"
                               BackgroundColor="#F3F3F3"
                               Margin="10,10,15,0">

                            <Entry Margin="20,0,0,0"
                                   BackgroundColor="#F3F3F3"
                                   TextColor="Black"
                                   FontFamily="Nunito-Bold"
                                   Placeholder="Section"
                                   PlaceholderColor="#848484"
                                   x:Name="sec"/>
                        </Frame>
                    </Grid>
                </StackLayout>

                <!-- Contact Num -->
                <StackLayout  Grid.Row="7">
                    <Frame
                       Padding="0" 
                       CornerRadius="15"
                       BackgroundColor="#F3F3F3"
                       Margin="10,10,10,0">
                        <Entry 
                           Margin="20,0,20,0"
                           BackgroundColor="#F3F3F3"
                           TextColor="Black"
                           FontFamily="Nunito-Bold"
                           Placeholder="Contact Number"
                           PlaceholderColor="#848484"
                           x:Name="contact">
                        </Entry>
                    </Frame>
                </StackLayout>

                <Button Grid.Row="8"
                        VerticalOptions="Center" 
                        HorizontalOptions="Center"
                        Padding="40,10,40,10"
                        CornerRadius="99"
                        Text="Register" 
                        Margin="0,30,0,0"
                        Clicked="Register_Clicked"/>

                <Label Grid.Row="9" 
                       Text="Already registered? Log In" 
                       TextColor="#747474"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontFamily="Nunito-Medium"
                       Margin="0,10,0,10"
                       x:Name="LabelColor">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </StackLayout>

    </ScrollView>
</ContentPage>
